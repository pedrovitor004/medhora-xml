<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/MedHora.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/medicine_icon" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_capsule" android:contentDescription="@string/pill_description"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:orientation="vertical">
            <TextView android:id="@+id/medicine_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MedHora.Subtitle"/>
            <TextView android:id="@+id/medicine_dose" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MedHora.Body"/>
            <TextView android:id="@+id/medicine_schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MedHora.Caption"/>
        </LinearLayout>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron" android:importantForAccessibility="no"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
