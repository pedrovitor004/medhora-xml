<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".ui.home.HomeFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/home_title"
        android:textSize="24sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/placeholder_message" />

    <Button
        android:id="@+id/button_cadastro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_cadastro" />
    <Button
        android:id="@+id/button_detalhes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_detalhes" />
    <Button
        android:id="@+id/button_historico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_historico" />
</LinearLayout>