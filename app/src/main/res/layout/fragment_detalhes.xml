<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/medhora_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" app:title="@string/detalhes_title" app:titleTextAppearance="@style/MedHora.Title" app:titleTextColor="@color/medhora_text" app:navigationIcon="@drawable/ic_back" app:navigationContentDescription="@string/back"/>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <ImageView android:id="@+id/medicine_icon" android:layout_width="88dp" android:layout_height="88dp" android:src="@drawable/ic_capsule" android:contentDescription="@string/pill_description" android:layout_gravity="center" android:padding="18dp" android:background="@drawable/bg_icon"/>
            <TextView android:id="@+id/medicine_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MedHora.Title" android:gravity="center" android:layout_marginTop="16dp"/>
            <TextView android:id="@+id/medicine_dose" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MedHora.Body" android:gravity="center" android:layout_marginTop="4dp"/>
            <com.google.android.material.card.MaterialCardView style="@style/MedHora.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MedHora.Subtitle" android:text="@string/daily_times_title"/>
                    <LinearLayout android:id="@+id/detail_times" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/MedHora.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MedHora.Subtitle" android:text="@string/frequency_label"/>
                    <TextView android:id="@+id/medicine_frequency" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MedHora.Body" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/MedHora.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MedHora.Subtitle" android:text="@string/last_dose"/>
                    <TextView android:id="@+id/last_dose" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MedHora.Body" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/MedHora.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MedHora.Subtitle" android:text="@string/notes_label"/>
                    <TextView android:id="@+id/medicine_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/MedHora.Body" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="20dp" android:paddingBottom="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/edit" style="@style/MedHora.OutlineButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/edit" android:layout_marginEnd="6dp" app:icon="@drawable/ic_edit"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/delete" style="@style/MedHora.OutlineButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/delete" android:layout_marginStart="6dp" app:icon="@drawable/ic_delete" app:iconTint="@color/medhora_error" app:strokeColor="@color/medhora_error" android:textColor="@color/medhora_error"/>
    </LinearLayout>
</LinearLayout>
