<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.MedHoraXML" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/medhora_green_primary</item>
        <item name="colorOnPrimary">@color/medhora_white</item>
        <item name="colorPrimaryContainer">@color/medhora_green_light</item>
        <item name="colorOnPrimaryContainer">@color/medhora_green_dark</item>
        <item name="colorSecondary">@color/medhora_green_primary</item>
        <item name="colorOnSecondary">@color/medhora_white</item>
        <item name="colorSecondaryContainer">@color/medhora_green_light</item>
        <item name="colorOnSecondaryContainer">@color/medhora_green_dark</item>
        <item name="colorSurface">@color/medhora_white</item>
        <item name="colorOnSurface">@color/medhora_text</item>
        <item name="colorOnSurfaceVariant">@color/medhora_muted</item>
        <item name="colorOutline">@color/medhora_border</item>
        <item name="colorError">@color/medhora_error</item>
        <item name="android:colorBackground">@color/medhora_background</item>
        <item name="android:windowBackground">@color/medhora_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/medhora_background</item>
        <item name="android:navigationBarColor">@color/medhora_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialButtonStyle">@style/MedHora.Button</item>
        <item name="textInputStyle">@style/MedHora.Input</item>
        <item name="materialAlertDialogTheme">@style/MedHora.Dialog</item>
    </style>
    <style name="Theme.MedHoraXML" parent="Base.Theme.MedHoraXML"/>
    <style name="MedHora.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/medhora_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="MedHora.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/medhora_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="MedHora.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/medhora_text</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="MedHora.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/medhora_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="MedHora.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/medhora_green_primary</item>
        <item name="android:textColor">@color/medhora_white</item>
    </style>
    <style name="MedHora.OutlineButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/medhora_green_primary</item>
        <item name="strokeColor">@color/medhora_green_accent</item>
    </style>
    <style name="MedHora.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/medhora_white</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="hintTextColor">@color/medhora_muted</item>
    </style>
    <style name="MedHora.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/medhora_white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="MedHora.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/medhora_white</item>
        <item name="shapeAppearanceMediumComponent">@style/MedHora.DialogShape</item>
    </style>
    <style name="MedHora.DialogShape" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">20dp</item>
    </style>
    <style name="MedHora.NavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
    </style>
    <style name="MedHora.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/medhora_green_light</item>
    </style>
</resources>
